#!/usr/bin/env python3
"""A herdr that answers from a script instead of from a terminal.

The demo has to show sessions talking to each other without opening real panes
or naming real repositories, and it has to produce the same frames every time
it is recorded. `HERDR_BIN` points the server here; every call the server makes
during a demo is answered from the table below.

It is not a simulator. It knows the handful of subcommands delivery actually
uses, and prints what herdr prints for them.
"""
import json
import sys

PANES = [
    # pane,   workspace, label,   cwd,          agent,    status
    ("w1:p1", "w1", "web", "/code/web", "claude", "idle"),
    ("w2:p1", "w2", "api", "/code/api", "codex", "idle"),
    ("w3:p1", "w3", "tests", "/code/tests", "claude", "working"),
    ("w4:p1", "w4", "design", "/code/design", "cursor", "idle"),
]

STATUS_OVERRIDE = {}


def agents():
    return [
        {
            "pane_id": p, "workspace_id": w, "cwd": c, "foreground_cwd": c,
            "agent": kind, "agent_status": STATUS_OVERRIDE.get(p, st),
            "tab_id": f"{w}:t1", "terminal_id": f"term_{p}", "focused": False,
            "agent_session": {"kind": "id", "value": f"sess-{p}"},
        }
        for p, w, _, c, kind, st in PANES
    ]


def panes():
    return [
        {
            "pane_id": p, "workspace_id": w, "cwd": c, "foreground_cwd": c,
            "agent_status": STATUS_OVERRIDE.get(p, st), "label": None,
            "tab_id": f"{w}:t1", "focused": False,
        }
        for p, w, _, c, _, st in PANES
    ]


def workspaces():
    return [
        {"workspace_id": w, "label": lb, "active_tab_id": f"{w}:t1",
         "agent_status": st, "focused": False, "number": i + 1,
         "pane_count": 1, "tab_count": 1}
        for i, (_, w, lb, _, _, st) in enumerate(PANES)
    ]


def out(payload):
    print(json.dumps({"id": "fake", "result": payload}))


argv = sys.argv[1:]
cmd = " ".join(argv[:2])

if cmd == "agent list":
    out({"type": "agent_list", "agents": agents()})
elif cmd == "pane list":
    out({"type": "pane_list", "panes": panes()})
elif cmd == "workspace list":
    out({"type": "workspace_list", "workspaces": workspaces()})
elif cmd == "agent prompt":
    # The whole point of the product, reduced to the one line it really is:
    # text goes into somebody else's prompt and is submitted.
    out({"type": "agent_prompted", "pane_id": argv[2] if len(argv) > 2 else None})
elif cmd in ("pane send-text", "pane send-keys"):
    out({"type": "ok"})
elif cmd == "pane read":
    print("❯ ")
elif argv[:1] == ["agent"]:
    # Feature detection: the server asks --help whether `agent prompt` exists.
    print("Usage: herdr agent <subcommand>\n\nCommands:\n  prompt     Submit a prompt to an agent\n  list       List agents")
else:
    out({"type": "ok"})
