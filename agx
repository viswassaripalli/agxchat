#!/usr/bin/env bash
# AGxChat CLI — lets any session send and read mail with no MCP setup.
#
#   mail agents
#   mail send <to> <subject> <body...>        --from NAME  --expect "shape"  --for HUMAN
#     --for names the person who asked. Send it whenever a human asked, so the
#     receiver can tell a human request from a bot one. Unverified by design.
#   mail inbox [name]
#   mail thread <mail-id>
#   mail reply <mail-id> <body...>
#
# Put it on PATH once:  ln -s $HOME/agxchat/mail /usr/local/bin/agx
set -euo pipefail
jq_or_cat() { python3 -m json.tool 2>/dev/null || cat; }

# Every response goes through here so an error body is reported as the server
# worded it. Without this a 401 reached a parser expecting mail and came out as
# a traceback, which tells the user nothing about the token.
api() {
  local path="$1"; shift
  local body code
  body="$(curl -s --max-time 10 -w '\n%{http_code}' "${AUTH[@]}" "$@" "$BASE$path" 2>/dev/null || true)"
  code="$(printf '%s' "$body" | tail -n1)"
  body="$(printf '%s' "$body" | sed '$d')"
  case "$code" in
    200|201) printf '%s' "$body"; return 0 ;;
    ""|000) echo "agx: server not answering on $BASE — start it with: agx serve" >&2; return 1 ;;
    401) echo "agx: unauthorized — token missing or stale (see $HOME_DIR/.run/token)" >&2; return 1 ;;
    *)
      printf '%s' "$body" | python3 -c "
import json,sys
try:
    d=json.load(sys.stdin)
    print('agx: ' + str(d.get('error') or d) + (' — ' + d['hint'] if d.get('hint') else ''), file=sys.stderr)
except Exception:
    print('agx: server returned HTTP $code', file=sys.stderr)
" 2>/dev/null || echo "agx: server returned HTTP $code" >&2
      return 1 ;;
  esac
}

# Shared secret, written by the server on first start. Every request carries
# it; without it the server answers 401 and nothing can type into your panes.
agx_token() {
  if [ -n "${AGX_TOKEN:-}" ]; then printf '%s' "$AGX_TOKEN"; return 0; fi
  [ -f "$HOME_DIR/.run/token" ] && tr -d '\n' < "$HOME_DIR/.run/token"
}

PORT="${AGX_PORT:-${HERDR_MAIL_PORT:-7777}}"

# Follow the symlink so `agx` works from any cwd and after `agx update`.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
HOME_DIR="${AGX_HOME:-$(cd "$(dirname "$SELF")" && pwd)}"
AUTH=(-H "X-AGX-Token: $(agx_token 2>/dev/null || true)")
BASE="http://127.0.0.1:$PORT"

# Which pane this command is running in. Defined before first use: bash
# resolves functions at call time, and the identity block below runs early —
# with the definition further down it failed with "my_pane: command not found".
my_pane() {
  # herdr exports this into the pane's environment; cheaper and more reliable
  # than shelling out, and it still works if the socket API is unavailable.
  if [ -n "${HERDR_PANE_ID:-}" ]; then
    printf '%s' "$HERDR_PANE_ID"
    return 0
  fi
  herdr pane current --current 2>/dev/null | python3 -c "
import json,sys
try: print(json.load(sys.stdin)['result']['pane']['pane_id'])
except Exception: pass
" 2>/dev/null || true
}


# Identity: --from wins, then $HERDR_MAIL_ME, then the git root's directory name.
FROM="${AGX_ME:-${HERDR_MAIL_ME:-}}"
ARGS=()
POINTERS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --from) FROM="$2"; shift 2 ;;
    --expect) EXPECT="$2"; shift 2 ;;
    --for|--requested-by) REQUESTED_BY="$2"; shift 2 ;;
    --via) VIA="$2"; shift 2 ;;
    --thread) THREAD="$2"; shift 2 ;;
    --pointer) POINTERS+=("$2"); shift 2 ;;
    --inline) INLINE=1; shift ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]}"
# Why this is careful: identity is what routing and reply-delivery hang off. A
# wrong sender means replies are addressed to a mailbox nobody reads, and the
# server treats an unresolvable sender as "reads via API" and never nudges. So
# each failure is named, and commands that write refuse rather than guess.
IDENTITY_PROBLEM=""
if [ -z "$FROM" ]; then
  # Identity is per pane, not per directory: two terminals in one repo are two
  # mailboxes. The server owns that mapping, so ask it about THIS pane.
  MY_PANE="$(my_pane)"
  if [ -z "$MY_PANE" ]; then
    IDENTITY_PROBLEM="not running inside a herdr pane (no HERDR_PANE_ID, and 'herdr pane current' gave nothing)"
  else
    WHOAMI_BODY="$(curl -s --max-time 2 -w '\n%{http_code}' "${AUTH[@]}" "$BASE/whoami?pane=$MY_PANE" 2>/dev/null || true)"
    WHOAMI_CODE="$(printf '%s' "$WHOAMI_BODY" | tail -n1)"
    case "$WHOAMI_CODE" in
      200)
        FROM="$(printf '%s' "$WHOAMI_BODY" | sed '$d' | python3 -c "
import json,sys
try: print(json.load(sys.stdin).get('identity') or '')
except Exception: pass
" 2>/dev/null || true)"
        [ -z "$FROM" ] && IDENTITY_PROBLEM="the server does not recognise pane $MY_PANE as a live agent"
        ;;
      401) IDENTITY_PROBLEM="the server rejected our token — check $HOME_DIR/.run/token, or restart with: agx stop && agx serve" ;;
      ""|000) IDENTITY_PROBLEM="the server is not answering on $BASE — start it with: agx serve" ;;
      *)   IDENTITY_PROBLEM="the server answered HTTP $WHOAMI_CODE for /whoami" ;;
    esac
  fi
fi

# Commands that create mail must have a real identity; read-only ones may
# proceed without, since nothing routes back to them.
case "${1:-}" in
  send|reply)
    if [ -z "$FROM" ]; then
      echo "agx: refusing to $1 without a resolved identity — $IDENTITY_PROBLEM" >&2
      echo "     mail from a guessed sender gets replies nobody reads. Pass --from <name> to override." >&2
      exit 1
    fi
    ;;
  *)
    if [ -z "$FROM" ]; then
      ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
      FROM="$(basename "$ROOT")"
      [ -n "$IDENTITY_PROBLEM" ] && echo "agx: using \"$FROM\" as a placeholder identity — $IDENTITY_PROBLEM" >&2
    fi
    ;;
esac
INLINE="${INLINE:-1}"
EXPECT="${EXPECT:-}"
REQUESTED_BY="${REQUESTED_BY:-${AGX_FOR:-${HERDR_MAIL_FOR:-}}}"
VIA="${VIA:-}"
THREAD="${THREAD:-}"
POINTERS=("${POINTERS[@]:-}")

CMD="${1:-help}"; shift || true

running() { curl -sf --max-time 2 "$BASE/health" >/dev/null 2>&1; }

case "$CMD" in
  serve)
    if running; then echo "already up on $PORT"; exit 0; fi
    mkdir -p "$HOME_DIR/.run"
    # </dev/null and disown matter: without them the child keeps the caller's
    # stdin and process group, so `agx serve` blocks instead of returning.
    (
      cd "$HOME_DIR" || exit 1
      nohup npx tsx mail-server.ts < /dev/null > "$HOME_DIR/.run/server.log" 2>&1 &
      echo $! > "$HOME_DIR/.run/server.pid"
      disown 2>/dev/null || true
    )
    for _ in $(seq 24); do running && break; sleep 0.5; done
    if running; then
      echo "AGxChat up on http://127.0.0.1:$PORT (log: $HOME_DIR/.run/server.log)"
    else
      echo "failed to start — last lines:" >&2; tail -20 "$HOME_DIR/.run/server.log" >&2; exit 1
    fi
    ;;
  stop)
    pkill -f "tsx mail-server.ts" 2>/dev/null && echo "stopped" || echo "was not running"
    ;;
  status)
    running || { echo "server: down (agx serve)"; exit 1; }
    api /health | python3 -m json.tool
    ;;
  chat)
    # --space puts the chat view in its own herdr workspace instead of a split.
    if [ "${1:-}" = "--space" ]; then
      # herdr returns the new pane as result.root_pane; the other shapes are
      # what `pane split` and `pane move` return, kept as fallbacks.
      CREATED=$(herdr workspace create --cwd "$HOME_DIR" --label "AGxChat" --no-focus)
      WS=$(printf '%s' "$CREATED" | python3 -c "
import json,sys
try: print(json.load(sys.stdin).get('result',{}).get('workspace',{}).get('workspace_id') or '')
except Exception: pass
")
      PANE=$(printf '%s' "$CREATED" \
        | python3 -c "
import json,sys
r = json.load(sys.stdin).get('result', {})
print(
    r.get('root_pane', {}).get('pane_id')
    or r.get('workspace', {}).get('active_pane_id')
    or r.get('pane', {}).get('pane_id')
    or ''
)")
      if [ -z "$PANE" ]; then
        # The workspace was created before the pane id failed to parse. Leaving
        # it behind is how you end up with two empty "AGxChat" spaces.
        [ -n "$WS" ] && herdr workspace close "$WS" >/dev/null 2>&1
        echo "could not resolve the new pane; run: npx tsx mail-tui.tsx" >&2
        exit 1
      fi
      herdr pane rename "$PANE" chat >/dev/null 2>&1 || true
      herdr pane run "$PANE" "cd $HOME_DIR && npx tsx mail-tui.tsx" >/dev/null
      echo "chat in workspace AGxChat, pane $PANE"
    elif [ -t 0 ] && [ -t 1 ]; then
      (cd "$HOME_DIR" && exec npx tsx mail-tui.tsx)
    else
      # No TTY: Ink needs raw mode and dies with a stack trace that says
      # nothing about why. This happens whenever `agx chat` is run from inside
      # an agent session rather than a bare shell, so put it in a pane instead.
      echo "agx: no TTY here (running inside an agent session?), so the chat view cannot draw." >&2
      echo "     opening it in its own herdr pane instead — 'agx chat --space'." >&2
      exec "$SELF" chat --space
    fi
    ;;
  update)
    git -C "$HOME_DIR" rev-parse --git-dir >/dev/null 2>&1 || { echo "$HOME_DIR is not a git clone" >&2; exit 1; }
    BEFORE=$(git -C "$HOME_DIR" rev-parse --short HEAD)
    if ! git -C "$HOME_DIR" pull --ff-only --quiet 2>/tmp/agx-pull-err; then
      echo "pull failed:" >&2; cat /tmp/agx-pull-err >&2
      if [ -n "$(git -C "$HOME_DIR" status --porcelain)" ]; then
        echo >&2
        echo "Local edits in $HOME_DIR are in the way. agents.json and .run/ are" >&2
        echo "ignored and always safe; anything else you changed needs stashing:" >&2
        echo "  git -C $HOME_DIR stash && agx update" >&2
      fi
      exit 1
    fi
    AFTER=$(git -C "$HOME_DIR" rev-parse --short HEAD)
    if [ "$BEFORE" = "$AFTER" ]; then echo "already current ($AFTER)"; exit 0; fi
    (cd "$HOME_DIR" && npm install --silent --no-audit --no-fund)
    echo "updated $BEFORE -> $AFTER"

    # Refresh the CLAUDE.md block IF it is already installed. An update should
    # carry a changed rule to the sessions that opted in, and must never install
    # one for someone who did not.
    RULE_FILE="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/CLAUDE.md"
    if grep -qF "<!-- agxchat:begin -->" "$RULE_FILE" 2>/dev/null; then
      python3 "$HOME_DIR/rule.py" install "$RULE_FILE" "$HOME_DIR/claude-rule.md" >/dev/null \
        && echo "refreshed the AGxChat block in $RULE_FILE (restart a session to pick it up)"
    fi

    # Your seed and mail survive: agents.json and .run/ are gitignored, and the
    # server replays the JSONL store on boot.
    if running; then
      pkill -f "tsx mail-server.ts" 2>/dev/null || true
      sleep 1
      "$SELF" serve
    fi
    ;;
  bootstrap)
    (cd "$HOME_DIR" && ./bootstrap.sh "$@")
    ;;
  agents)
    api /agents | python3 -c "
import json,sys
for a in json.load(sys.stdin)['agents']:
    t=' '.join(a['topics']) or '-'
    print(f\"{str(a['name']):16} {str(a.get('kind') or '?'):8} {str(a['paneId']):7} {str(a['repo']):18} {a['status']:8} [{t}]\")"
    ;;
  send)
    TO="${1:?usage: mail send <to> <subject> <body...>}"; shift
    SUBJECT="${1:?subject required}"; shift
    BODY="$*"
    python3 -c "
import json,sys,urllib.request
frm,to,subject,body,inline,base,expect,requested_by,via,from_pane,thread,token = sys.argv[1:13]
pointers=[p for p in sys.argv[13:] if p]
payload={'from':frm,'to':to,'subject':subject,'body':body,'inline':inline=='1'}
if expect: payload['expect']=expect
if requested_by: payload['requested_by']=requested_by
if via: payload['via']=via
if from_pane: payload['from_pane']=from_pane
if thread: payload['thread']=thread
if pointers: payload['pointers']=pointers
req=urllib.request.Request(base+'/mail',json.dumps(payload).encode(),
                           {'Content-Type':'application/json','X-AGX-Token':token})
try:
    print(json.dumps(json.load(urllib.request.urlopen(req)),indent=2))
except urllib.error.HTTPError as e:
    print(e.read().decode()); sys.exit(1)
" "$FROM" "$TO" "$SUBJECT" "$BODY" "$INLINE" "$BASE" "$EXPECT" "$REQUESTED_BY" "$VIA" "$(my_pane)" "$THREAD" "$(agx_token)" "${POINTERS[@]}"
    ;;
  inbox)
    WHO="${1:-$FROM}"
    api "/mail?to=$WHO" | python3 -c "
import json,sys
ms=json.load(sys.stdin)['mail']
if not ms: print('inbox empty'); raise SystemExit
for m in ms:
    behalf = f\" on behalf of {m['requestedBy']}\" if m.get('requestedBy') else ' (no human named — bot-initiated)'
    print(f\"[{m['id']}] {m['kind']:5} from {m['from']:10}{behalf}  {m['delivery']:14} {'read' if m['readAt'] else 'UNREAD'}\")
    print(f\"   {m['subject']}\")
    print('   '+m['body'].replace(chr(10),chr(10)+'   '))
    if m['pointers']: print('   files:', ', '.join(m['pointers']))
    print()"
    ;;
  uninstall)
    PURGE=0
    CONFIRMED=0
    for a in "$@"; do
      case "$a" in
        --yes) CONFIRMED=1 ;;
        --purge) PURGE=1 ;;
      esac
    done
    RULE_FILE="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/CLAUDE.md"
    BACKUP="$HOME/.agxchat-backup-$(date +%Y%m%d-%H%M%S)"
    if [ "$CONFIRMED" -ne 1 ]; then
      cat >&2 <<EOF
agx uninstall removes AGxChat from this machine:

  · stops the server and the chat view
  · closes herdr workspaces labelled AGxChat
  · removes the AGxChat block from every agent instruction file it wrote to
  · removes the agx (and mail-herdr) symlinks
  · deletes $HOME_DIR

Your seed and mail are copied to $BACKUP first.
Add --purge to delete them with everything else, --yes to go ahead:

  agx uninstall --yes
EOF
      exit 1
    fi

    echo "stopping the server"
    pkill -f "tsx mail-server.ts" 2>/dev/null || true
    pkill -f "mail-tui.tsx" 2>/dev/null || true

    if command -v herdr >/dev/null 2>&1; then
      for WS in $(herdr workspace list 2>/dev/null | python3 -c "
import json,sys
try: ws=json.load(sys.stdin)['result']['workspaces']
except Exception: ws=[]
for w in ws:
    if (w.get('label') or '').lower() == 'agxchat': print(w['workspace_id'])
" 2>/dev/null); do
        herdr workspace close "$WS" >/dev/null 2>&1 && echo "closed workspace $WS"
      done
    fi

    python3 "$HOME_DIR/rule.py" remove-all 2>/dev/null | grep -v "^no AGxChat block" || true

    if [ "$PURGE" -eq 1 ]; then
      echo "purging seed and mail (no backup kept)"
    else
      mkdir -p "$BACKUP"
      [ -f "$HOME_DIR/agents.json" ] && cp "$HOME_DIR/agents.json" "$BACKUP/" 2>/dev/null
      [ -f "$HOME_DIR/.run/mail.jsonl" ] && cp "$HOME_DIR/.run/mail.jsonl" "$BACKUP/" 2>/dev/null
      echo "kept your seed and mail in $BACKUP"
    fi

    # Only unlink symlinks that point at THIS install; someone else's agx on
    # PATH is not ours to remove.
    for LINK in /usr/local/bin/agx "$HOME/.local/bin/agx" "$HOME/bin/agx" \
                /usr/local/bin/mail-herdr "$HOME/.local/bin/mail-herdr"; do
      if [ -L "$LINK" ] && [ "$(readlink "$LINK")" = "$HOME_DIR/agx" ]; then
        rm -f "$LINK" && echo "unlinked $LINK"
      fi
    done

    # bash reads a script incrementally, so a running agx cannot delete its own
    # directory safely. Hand the last step to a detached copy.
    CLEANUP=$(mktemp /tmp/agx-uninstall.XXXXXX)
    cat > "$CLEANUP" <<EOF
#!/usr/bin/env bash
sleep 1
rm -rf "$HOME_DIR"
rm -f "$CLEANUP"
EOF
    chmod +x "$CLEANUP"
    nohup "$CLEANUP" < /dev/null > /dev/null 2>&1 &
    disown 2>/dev/null || true
    echo "removed $HOME_DIR"
    echo
    echo "AGxChat is gone. Reinstall any time:"
    echo "  curl -fsSL https://raw.githubusercontent.com/viswassaripalli/agxchat/main/install.sh | bash"
    ;;
  seed)
    SEED_FILE="$HOME_DIR/agents.json"
    case "${1:-show}" in
      detect)
        python3 "$HOME_DIR/seed.py" detect "$SEED_FILE"
        ;;
      preview)
        python3 "$HOME_DIR/seed.py" detect --print
        ;;
      edit)
        # $EDITOR is often unset, and then `$EDITOR file` runs the file as a
        # command. Fall back through the editors that are actually installed.
        for ed in "${VISUAL:-}" "${EDITOR:-}" nano vim vi; do
          [ -n "$ed" ] && command -v "$ed" >/dev/null 2>&1 && exec "$ed" "$SEED_FILE"
        done
        echo "no editor found; the file is at $SEED_FILE" >&2
        exit 1
        ;;
      show)
        cat "$SEED_FILE" 2>/dev/null || { echo "no seed yet; run: agx seed detect" >&2; exit 1; }
        ;;
      *) echo "usage: agx seed [detect|preview|edit|show]" >&2; exit 2 ;;
    esac
    ;;
  rule)
    # Installing the CLI is not enough: a session only reaches for AGxChat if
    # its own instruction file tells it to — and every agent reads a different
    # file, so by default we write to all of them that exist here.
    RULE_FILE="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/CLAUDE.md"
    case "${1:-show}" in
      show)
        cat "$HOME_DIR/claude-rule.md"
        echo
        echo "# install with:  agx rule install     (targets: agx rule targets)"
        ;;
      targets)
        python3 "$HOME_DIR/rule.py" targets
        ;;
      install)
        if [ "${2:-}" = "--claude-only" ]; then
          python3 "$HOME_DIR/rule.py" install "$RULE_FILE" "$HOME_DIR/claude-rule.md"
        else
          python3 "$HOME_DIR/rule.py" install-all "$HOME_DIR/claude-rule.md"
        fi
        echo "instruction files are read at session start — restart a session for it to take effect."
        ;;
      remove)
        if [ "${2:-}" = "--claude-only" ]; then
          python3 "$HOME_DIR/rule.py" remove "$RULE_FILE"
        else
          python3 "$HOME_DIR/rule.py" remove-all
        fi
        ;;
      *) echo "usage: agx rule install|remove|show|targets [--claude-only]" >&2; exit 2 ;;
    esac
    ;;
  whoami)
    api "/whoami?pane=$(my_pane)" | jq_or_cat
    ;;
  provenance)
    api /provenance | python3 -c "
import json,sys
d=json.load(sys.stdin)
if not d['claims']: print('no claims of human authority'); raise SystemExit
for c in d['claims']:
    flag='SECOND-HAND via '+str(c['via']) if c['kind']=='second-hand' else 'first-hand'
    print(f\"{c['id']} {c['from']:9}-> {c['to']:9} for {c['requested_by']:8} [{flag}]  {c['subject'][:40]}\")
print()
print('second-hand claims:', d['second_hand'], '| dangling via refs:', d['dangling'] or 'none')"
    ;;
  deleted)
    api /deleted | python3 -c "
import json,sys
ds=json.load(sys.stdin)['deleted']
if not ds: print('nothing deleted'); raise SystemExit
for d in ds: print(f\"{d['id']} {d['from']:9}-> {d['to']:9} {d['subject'][:56]}\")"
    ;;
  restore)
    ID="${1:?usage: agx restore <mail-id>}"
    curl -s "${AUTH[@]}" -X POST "$BASE/mail/$ID/restore" | jq_or_cat
    ;;
  delete)
    ID="${1:?usage: agx delete <mail-id>}"
    curl -s "${AUTH[@]}" -X DELETE "$BASE/mail/$ID" | jq_or_cat
    ;;
  delete-thread)
    ID="${1:?usage: agx delete-thread <mail-id>}"
    curl -s "${AUTH[@]}" -X DELETE "$BASE/thread/$ID" | jq_or_cat
    ;;
  clear)
    if [ "${1:-}" != "--yes" ]; then
      echo "this deletes every message and cannot be undone. re-run: agx clear --yes" >&2
      exit 1
    fi
    curl -s "${AUTH[@]}" -X DELETE "$BASE/mail?confirm=yes" | jq_or_cat
    ;;
  thread)
    ID="${1:?usage: mail thread <mail-id>}"
    api /mail | python3 -c "
import json,sys
ms=json.load(sys.stdin)['mail']; want=sys.argv[1]
ids={want} | {m['id'] for m in ms if m.get('replyTo')==want}
for m in sorted((m for m in ms if m['id'] in ids), key=lambda m: m['createdAt']):
    print(f\"[{m['id']}] {m['from']} -> {m['to']} ({m['delivery']})\")
    print(f\"   {m['subject']}\"); print('   '+m['body'].replace(chr(10),chr(10)+'   ')); print()" "$ID"
    ;;
  reply)
    ID="${1:?usage: mail reply <mail-id> <body...>}"; shift
    BODY="$*"
    python3 -c "
import json,sys,urllib.request
payload=json.dumps({'mail_id':sys.argv[1],'from':sys.argv[2],'body':sys.argv[3]}).encode()
req=urllib.request.Request(sys.argv[4]+'/reply',payload,
                           {'Content-Type':'application/json','X-AGX-Token':sys.argv[5]})
try:
    print(json.dumps(json.load(urllib.request.urlopen(req)),indent=2))
except urllib.error.HTTPError as e:
    print(e.read().decode()); sys.exit(1)
" "$ID" "$FROM" "$BODY" "$BASE" "$(agx_token)"
    ;;
  *)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
